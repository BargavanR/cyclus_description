<?xml version="1.0" ?>
<!--
  File: cyclus_showcase.world.sdf
  Purpose: Stable showcase Gazebo world for the cyclus_description package with improved outdoor lighting and textured ground.
  Author: BARGAVAN R
  Contact: bargavanr01@gmail.com
-->
<sdf version="1.8">
  <world name="cyclus_showcase_world">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.28 0.30 0.33 1.0</ambient>
      <background>0.68 0.75 0.84 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <!-- <sky>
        <time>12</time>
        <sunrise>6</sunrise>
        <sunset>18</sunset>
      </sky> -->
    </scene>

    <light name="sun_main" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>0.88 0.84 0.76 1.0</diffuse>
      <specular>0.18 0.17 0.15 1.0</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.9</constant>
        <linear>0.001</linear>
        <quadratic>0.00002</quadratic>
      </attenuation>
      <direction>-0.40 0.24 -0.88</direction>
    </light>

    <light name="sun_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 28 0 0 0</pose>
      <diffuse>0.10 0.13 0.18 1.0</diffuse>
      <specular>0.02 0.02 0.03 1.0</specular>
      <attenuation>
        <range>1200</range>
        <constant>1.0</constant>
        <linear>0.001</linear>
        <quadratic>0.00005</quadratic>
      </attenuation>
      <direction>0.55 -0.20 -0.81</direction>
    </light>

    <model name="showcase_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <pose>0 0 -0.075 0 0 0</pose>
          <geometry>
            <box>
              <size>240 240 0.15</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <pose>0 0 -0.076 0 0 0</pose>
          <geometry>
            <box>
              <size>240 240 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.51 0.48 1.0</ambient>
            <diffuse>0.66 0.64 0.60 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>../materials/textures/showcase_ground_albedo.png</albedo_map>                <roughness>0.95</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Fixed operator cameras. These are static world sensors and do not
         participate in robot physics or controller behavior. -->
    <model name="camera_top">
      <static>true</static>
      <pose>1.2 0 4.2 0 1.5708 0</pose>
      <link name="link">
        <visual name="vis_body">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <sensor name="camera_top" type="camera">
          <update_rate>30</update_rate>
          <topic>camera_top/image</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <model name="camera_side">
      <static>true</static>
      <pose>1.2 3.2 1.8 0 0.35 -1.5708</pose>
      <link name="link">
        <visual name="vis_body">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <sensor name="camera_side" type="camera">
          <update_rate>30</update_rate>
          <topic>camera_side/image</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <model name="camera_front">
      <static>true</static>
      <pose>4.2 0 1.8 0 0.35 3.14159</pose>
      <link name="link">
        <visual name="vis_body">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <sensor name="camera_front" type="camera">
          <update_rate>30</update_rate>
          <topic>camera_front/image</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>20.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
