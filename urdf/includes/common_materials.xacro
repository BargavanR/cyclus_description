<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cyclus_shared_materials">
    <material name="steel_frame">
      <color rgba="0.29 0.31 0.34 1.0" />
    </material>

    <material name="rail_bronze">
      <color rgba="0.53 0.34 0.18 1.0" />
    </material>

    <material name="carrier_charcoal">
      <color rgba="0.22 0.24 0.27 1.0" />
    </material>

    <material name="carrier_blue">
      <color rgba="0.18 0.32 0.56 1.0" />
    </material>

    <material name="carrier_black">
      <color rgba="0.12 0.13 0.15 1.0" />
    </material>

    <material name="tesla_red">
      <color rgba="0.76 0.12 0.10 1.0" />
    </material>

    <material name="lift_plate_grey">
      <color rgba="0.82 0.84 0.86 1.0" />
    </material>

    <!-- Cybertruck Stainless Steel -->
    <material name="cybertruck_steel">
      <color rgba="0.62 0.64 0.66 1.0" />
    </material>
  </xacro:macro>
</robot>
