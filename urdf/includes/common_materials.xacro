<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cyclus_shared_materials">
    <material name="steel_frame">
      <color rgba="0.28 0.31 0.34 1.0" />
    </material>

    <material name="rail_bronze">
      <color rgba="0.38 0.23 0.12 1.0" />
    </material>

    <material name="carrier_charcoal">
      <color rgba="0.10 0.45 0.90 1.0" />
    </material>

    <material name="carrier_blue">
      <color rgba="0.16 0.31 0.70 1.0" />
    </material>

    <material name="carrier_black">
      <color rgba="0.10 0.45 0.90 1.0" />
    </material>

    <material name="tesla_red">
      <color rgba="0.72 0.08 0.11 1.0" />
    </material>

    <material name="lift_plate_grey">
      <color rgba="0.84 0.85 0.83 1.0" />
    </material>

    <!-- Cybertruck Stainless Steel -->
    <material name="cybertruck_steel">
      <color rgba="0.28 0.29 0.31 1.0" />
    </material>
  </xacro:macro>
</robot>
