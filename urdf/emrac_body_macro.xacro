<!--
  Purpose: Reusable EMRAC body macro for the cyclus_description package.
  Author: BARGAVAN R
  Contact: bargavanr01@gmail.com
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="emrac_body_instance" params="prefix">
  <xacro:property name="lift_plate_scale" value="0.001 0.001 0.001" />
  <xacro:property name="lift_plate_mount_y" value="-0.29" />
  <xacro:property name="lift_plate_travel" value="0.6" />
  <xacro:property name="lift_plate_origin_x" value="-1.90140869140626" />
  <xacro:property name="lift_plate_origin_y" value="-0.40512716674804685857" />
  <xacro:property name="lift_plate_origin_z" value="0.45429059314727783" />
  <xacro:property name="lift_plate_roll" value="1.5707963267949" />
  <xacro:property name="lift_plate_collision_size" value="1.02 0.66 0.03" />
  <xacro:property name="dock_arm_collision_length" value="0.78" />
  <xacro:property name="dock_arm_collision_radius" value="0.02" />

  <link name="${prefix}emrac_body_root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <joint name="${prefix}emrac_body_root_to_base_link" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267949 0 3.14159265358979" />
    <parent link="${prefix}emrac_body_root"/>
    <child link="${prefix}base_link"/>
  </joint>


  <link name="${prefix}base_link">
    <inertial>
      <origin xyz="0.231326122438629 -0.729625066059866 -0.384275142354278" rpy="0 0 0" />
      <mass value="66.8400447533962" />
      <inertia ixx="0.126647867330863" ixy="1.09468303143366E-14" ixz="1.49222860415562E-14" iyy="0.489903098665309" iyz="-7.74690196420397E-11" izz="0.480399430509725" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/base_link.STL" />
      </geometry>
      <material name="carrier_charcoal" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/collision/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link name="${prefix}docking_1">
    <inertial>
      <origin xyz="1.57308467822174 0.780045273498867 -0.0905675614190253" rpy="0 0 0" />
      <mass value="0.0202336294869927" />
      <inertia ixx="9.72507400857707E-07" ixy="-2.37554290260085E-20" ixz="1.13271025171526E-20" iyy="8.0553172643547E-06" iyz="3.70971200079535E-35" izz="8.0553172643547E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/docking_1.STL" />
      </geometry>
      <material name="carrier_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/collision/docking_1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}dock_joint_1" type="fixed">
    <origin xyz="-1.90167019372611 -0.688928868898414 0.456357618202888" rpy="1.5707963267949 0 0" />
    <parent link="${prefix}base_link"/>
    <child link="${prefix}docking_1"/>
    <axis xyz="0 0 0" />
  </joint>
  <link name="${prefix}dock_arm_1">
    <inertial>
      <origin xyz="-0.000499999999999778 -0.000407762481728469 -0.000569115410858689" rpy="0 0 0" />
      <mass value="0.00150072453201757" />
      <inertia ixx="5.7113098325987E-07" ixy="-2.09373257761955E-22" ixz="-9.42175268372246E-22" iyy="3.76033847997044E-07" iyz="6.32661441841782E-11" izz="1.95347256018162E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/dock_arm_1.STL" />
      </geometry>
      <material name="rail_bronze" />
    </visual>
    <collision>
      <origin xyz="0.39 0 0" rpy="0 1.5707963267949 0" />
      <geometry>
        <cylinder radius="${dock_arm_collision_radius}" length="${dock_arm_collision_length}" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}arm_joint_1" type="revolute">
    <origin xyz="1.53958467822174 0.780045273498867 -0.0905675614190252" rpy="-1.57079632679425 0 -3.14159265358979" />
    <parent link="${prefix}docking_1"/>
    <child link="${prefix}dock_arm_1"/>
    <axis xyz="-1 0 0" />
    <limit lower="-0.78539816339" upper="0.78539816339" effort="200.0" velocity="1.0" />
    <dynamics damping="50.0" friction="20.0" />
  </joint>
  <link name="${prefix}docking_2">
    <inertial>
      <origin xyz="1.57325903320313 0.822636592430764 -0.0944039787894341" rpy="0 0 0" />
      <mass value="0.0202336294869927" />
      <inertia ixx="9.72507400857707E-07" ixy="-2.37554290260085E-20" ixz="1.13271025171526E-20" iyy="8.0553172643547E-06" iyz="3.90082702343961E-35" izz="8.0553172643547E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/docking_2.STL" />
      </geometry>
      <material name="carrier_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/collision/docking_2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}docking_joint_2" type="fixed">
    <origin xyz="-0.85761797977807 -0.693687257483896 0.414480042632792" rpy="1.5707963267949 0 0" />
    <parent link="${prefix}base_link"/>
    <child link="${prefix}docking_2"/>
    <axis xyz="1 0 0" />
  </joint>
  <link name="${prefix}dock_arm_2">
    <inertial>
      <origin xyz="0.030939911474413 0.000569115410858911 0.000407762481728025" rpy="0 0 0" />
      <mass value="0.00150072453201757" />
      <inertia ixx="5.7113098325987E-07" ixy="6.42213640349087E-22" ixz="1.33311741135265E-22" iyy="1.95347256018162E-07" iyz="6.32661443007841E-11" izz="3.76033847997044E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/dock_arm_2.STL" />
      </geometry>
      <material name="rail_bronze" />
    </visual>
    <collision>
      <origin xyz="0.39 0 0" rpy="0 1.5707963267949 0" />
      <geometry>
        <cylinder radius="${dock_arm_collision_radius}" length="${dock_arm_collision_length}" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}arm_joint_2" type="revolute">
    <origin xyz="1.50831912172871 0.822636592430764 -0.094403978789434" rpy="0 0 0" />
    <parent link="${prefix}docking_2"/>
    <child link="${prefix}dock_arm_2"/>
    <axis xyz="1 0 0" />
    <limit lower="-0.78539816339" upper="0.78539816339" effort="200.0" velocity="1.0" />
    <dynamics damping="50.0" friction="20.0" />
  </joint>
  <link name="${prefix}docking_3">
    <inertial>
      <origin xyz="1.57325903320313 0.822636592430764 -0.0944039787894342" rpy="0 0 0" />
      <mass value="0.0202336294869927" />
      <inertia ixx="9.72507400857707E-07" ixy="-2.37554290260085E-20" ixz="1.13271025171526E-20" iyy="8.0553172643547E-06" iyz="3.78249840438576E-35" izz="8.0553172643547E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/docking_3.STL" />
      </geometry>
      <material name="carrier_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/collision/docking_3.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}docking_joint_3" type="fixed">
    <origin xyz="-1.89847364561348 -0.683810169290989 -1.15695984220038" rpy="1.5707963267949 0 0" />
    <parent link="${prefix}base_link"/>
    <child link="${prefix}docking_3"/>
    <axis xyz="0 0 0" />
  </joint>
  <link name="${prefix}dock_arm_3">
    <inertial>
      <origin xyz="0.974355659733319 -0.00103549815645604 -0.00165333769388842" rpy="0 0 0" />
      <mass value="0.00150072453201743" />
      <inertia ixx="5.71130983246695E-07" ixy="-2.2206301702031E-12" ixz="3.7386126927141E-16" iyy="1.95347256031264E-07" iyz="6.32661442999355E-11" izz="3.76033847997012E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/dock_arm_3.STL" />
      </geometry>
      <material name="rail_bronze" />
    </visual>
    <collision>
      <origin xyz="-0.39 0 0" rpy="0 1.5707963267949 0" />
      <geometry>
        <cylinder radius="${dock_arm_collision_radius}" length="${dock_arm_collision_length}" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}arm_joint_3" type="revolute">
    <origin xyz="2.58061469903853 0.821037736652904 -0.0923428786138167" rpy="0 0 -3.14158674425948" />
    <parent link="${prefix}docking_3"/>
    <child link="${prefix}dock_arm_3"/>
    <axis xyz="-0.99999999998254 0 0" />
    <limit lower="-0.78539816339" upper="0.78539816339" effort="200.0" velocity="1.0" />
    <dynamics damping="50.0" friction="20.0" />
  </joint>
  <link name="${prefix}docking_4">
    <inertial>
      <origin xyz="1.57325903320313 0.822636592430764 -0.0944039787894342" rpy="0 0 0" />
      <mass value="0.0202336294869927" />
      <inertia ixx="9.72507400857707E-07" ixy="-2.37554290260085E-20" ixz="1.13271025171526E-20" iyy="8.0553172643547E-06" iyz="3.78249840438577E-35" izz="8.0553172643547E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/docking_4.STL" />
      </geometry>
      <material name="carrier_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/collision/docking_4.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}docking_arm_4" type="fixed">
    <origin xyz="-0.857617979778071 -0.686214402146105 -1.15890213114568" rpy="1.5707963267949 0 0" />
    <parent link="${prefix}base_link"/>
    <child link="${prefix}docking_4"/>
    <axis xyz="0 0 0" />
  </joint>
  <link name="${prefix}dock_arm_4">
    <inertial>
      <origin xyz="-1.13743235222051 0.000575836874332936 0.000407762481724361" rpy="0 0 0" />
      <mass value="0.00150072453201743" />
      <inertia ixx="5.71130983246695E-07" ixy="-2.220630166025E-12" ixz="3.73861273025674E-16" iyy="1.95347256031264E-07" iyz="6.32661442998097E-11" izz="3.76033847997012E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/carrier_emrac/visual/dock_arm_4.STL" />
      </geometry>
      <material name="rail_bronze" />
    </visual>
    <collision>
      <origin xyz="-0.39 0 0" rpy="0 1.5707963267949 0" />
      <geometry>
        <cylinder radius="${dock_arm_collision_radius}" length="${dock_arm_collision_length}" />
      </geometry>
    </collision>
  </link>
  <joint name="${prefix}arm_joint_4" type="revolute">
    <origin xyz="0.468826677599663 0.82263659243076 -0.0944039787894324" rpy="0 0 -3.14158674425949" />
    <parent link="${prefix}docking_4"/>
    <child link="${prefix}dock_arm_4"/>
    <axis xyz="0.99999999998254 0 0" />
    <limit lower="-0.78539816339" upper="0.78539816339" effort="200.0" velocity="1.0" />
    <dynamics damping="50.0" friction="20.0" />
  </joint>

  <link name="${prefix}lift_plate_carrier">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <link name="${prefix}lift_plate">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="12.0" />
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5" />
    </inertial>
    <visual>
      <origin xyz="${lift_plate_origin_x} ${lift_plate_origin_y} ${lift_plate_origin_z}" rpy="${lift_plate_roll} 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/emrac/EMRAC Lift Plate Dwn Pos 1.stl" scale="${lift_plate_scale}" />
      </geometry>
      <material name="rail_bronze" />
    </visual>
    <collision>
      <origin xyz="${lift_plate_origin_x} ${lift_plate_origin_y} ${lift_plate_origin_z}" rpy="${lift_plate_roll} 0 0" />
      <geometry>
        <box size="${lift_plate_collision_size}" />
      </geometry>
    </collision>
  </link>

  <joint name="${prefix}base_to_lift_plate_carrier" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lift_plate_carrier"/>
    <axis xyz="0 -1 0" />
    <limit lower="-${lift_plate_travel}" upper="${lift_plate_travel}" effort="1000.0" velocity="0.55" />
    <dynamics damping="1.0" friction="0.05" />
  </joint>

  <joint name="${prefix}lift_plate_mount" type="fixed">
    <origin xyz="0 ${lift_plate_mount_y} 0" rpy="0 0 0" />
    <parent link="${prefix}lift_plate_carrier"/>
    <child link="${prefix}lift_plate"/>
  </joint>

  <gazebo reference="${prefix}base_link">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="${prefix}docking_1">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="${prefix}dock_arm_1">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="${prefix}docking_2">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="${prefix}dock_arm_2">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="${prefix}docking_3">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="${prefix}dock_arm_3">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="${prefix}docking_4">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="${prefix}dock_arm_4">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="${prefix}lift_plate_carrier">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="${prefix}lift_plate">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>
  </xacro:macro>
</robot>
