<?xml version="1.0"?>
<package format="3">
  <name>cyclus_description</name>
  <version>0.0.1</version>
  <description>Cyclus description package for static structure visualization in Gazebo Fortress.</description>
  <maintainer email="bargavan@example.com">bargavan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>controller_manager</depend>
  <depend>gz_ros2_control</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>position_controllers</depend>
  <depend>rclpy</depend>
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>std_msgs</depend>
  <depend>xacro</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
