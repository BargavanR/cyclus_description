      </geometry>
      <material name="carrier_black" />
    </visual>
    <collision>
      <origin xyz="${docking_collision_origin_2}" rpy="0 0 0" />
      <geometry>
        <box size="${docking_collision_size}" />
      </geometry>
    </collision>
  </link>
  <joint name="docking_arm_4" type="fixed">
    <origin xyz="-0.857617979778071 -0.686214402146105 -1.15890213114568" rpy="1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="docking_4" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="dock_arm_4">
    <inertial>
      <origin xyz="-1.13743235222051 0.000575836874332936 0.000407762481724361" rpy="0 0 0" />
      <mass value="0.00150072453201743" />
      <inertia ixx="5.71130983246695E-07" ixy="-2.220630166025E-12" ixz="3.73861273025674E-16" iyy="1.95347256031264E-07" iyz="6.32661442998097E-11" izz="3.76033847997012E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/bargavan/cyclus/src/carrier_emrac/meshes/visual/dock_arm_4.STL" />
      </geometry>
      <material name="carrier_black" />
    </visual>
    <collision>
      <origin xyz="-0.39 0 0" rpy="0 1.5707963267949 0" />
      <geometry>
        <cylinder radius="${dock_arm_collision_radius}" length="${dock_arm_collision_length}" />
      </geometry>
    </collision>
  </link>
  <joint name="arm_joint_4" type="revolute">
    <origin xyz="0.468826677599663 0.82263659243076 -0.0944039787894324" rpy="0 0 -3.14158674425949" />
    <parent link="docking_4" />
    <child link="dock_arm_4" />
    <axis xyz="0.99999999998254 0 0" />
    <limit lower="-0.78539816339" upper="0.78539816339" effort="200.0" velocity="1.0" />
    <dynamics damping="50.0" friction="20.0" />
  </joint>

  <link name="lift_plate_carrier">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <link name="lift_plate">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="12.0" />
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5" />
    </inertial>
    <visual>
      <origin xyz="${lift_plate_origin_x} ${lift_plate_origin_y} ${lift_plate_origin_z}" rpy="${lift_plate_roll} 0 0" />
      <geometry>
        <mesh filename="file://$(find cyclus_description)/meshes/emrac/EMRAC Lift Plate Dwn Pos 1.stl" scale="${lift_plate_scale}" />
      </geometry>
      <material name="lift_plate_grey" />
    </visual>
    <collision>
      <origin xyz="${lift_plate_origin_x} ${lift_plate_origin_y} ${lift_plate_origin_z}" rpy="${lift_plate_roll} 0 0" />
      <geometry>
        <box size="${lift_plate_collision_size}" />
      </geometry>
    </collision>
  </link>

  <joint name="base_to_lift_plate_carrier" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lift_plate_carrier" />
    <axis xyz="0 -1 0" />
    <limit lower="-${lift_plate_travel}" upper="${lift_plate_travel}" effort="1000.0" velocity="0.58" />
    <dynamics damping="1.0" friction="0.05" />
  </joint>

  <joint name="lift_plate_mount" type="fixed">
    <origin xyz="0 ${lift_plate_mount_y} 0" rpy="0 0 0" />
    <parent link="lift_plate_carrier" />
    <child link="lift_plate" />
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="world_to_integrated_root">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="emrac_slide_axis_1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="emrac_slide_axis_2">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="base_to_lift_plate_carrier">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="arm_joint_1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="arm_joint_2">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="arm_joint_3">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="arm_joint_4">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

  <gazebo>
    <self_collide>false</self_collide>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find cyclus_description)/config/cyclus_integrated_controllers.yaml</parameters>
      <controller_manager_node_name>controller_manager</controller_manager_node_name>
    </plugin>
  </gazebo>

  <gazebo reference="integrated_root">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="stationary_structure_right">
    <material>Gazebo/Grey</material>
    <gravity>true</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="stationary_structure_left">
    <material>Gazebo/Grey</material>
    <gravity>true</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="ground_rails">
    <material>Gazebo/Grey</material>
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="emrac_axis_1_carrier">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="emrac_axis_2_carrier">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="docking_1">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="dock_arm_1">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>true</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="docking_2">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="dock_arm_2">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>true</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="docking_3">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="dock_arm_3">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>true</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="docking_4">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="dock_arm_4">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <self_collide>true</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="lift_plate_carrier">
    <gravity>false</gravity>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="lift_plate">
    <material>Gazebo/LightGrey</material>
    <gravity>false</gravity>
    <self_collide>true</self_collide>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>
</robot>
